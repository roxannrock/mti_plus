# Matches the container started by `make db-up` (user mti, port 5433 on
# 127.0.0.1). In production start it with `make db-up DB_PASSWORD=...` and
# put the same password here.
DATABASE_URL="postgresql://mti:mti_dev_pw@localhost:5433/mti_exam?schema=public"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="12h"

PORT=4000
# Interface to listen on; keep 127.0.0.1 (the API is reached through Nginx).
HOST=127.0.0.1
# Reverse-proxy hops to trust for X-Forwarded-For. Empty = 1 in production
# (NODE_ENV=production, behind Nginx), off in development.
TRUST_PROXY=
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="replace-me"
SEED_ADMIN_NAME="Admin"

# Optional — one test student account, for local testing before LDAP sync
# creates real student accounts. Leave unset to skip.
SEED_STUDENT_LOGIN="student"
SEED_STUDENT_PASSWORD="replace-me"
SEED_STUDENT_NAME="Test Student"
