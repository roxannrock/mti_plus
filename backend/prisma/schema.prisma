// Prisma schema for the MTI+ exam platform.
// Sections/domains are free-form strings extracted from the uploaded MD file,
// never hardcoded here, so the same schema works for any subject (CompTIA,
// cybersecurity, etc.) without code changes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
}

model User {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  fullName     String
  role         Role
  createdAt    DateTime @default(now())

  createdTests Test[]     @relation("TestAuthor")
  attempts     Attempt[]

  @@map("users")
}

model Test {
  id            String   @id @default(cuid())
  title         String
  description   String?
  passPercent   Float // e.g. 70 = must score >= 70% to pass
  mdSource      String   @db.Text // original MD uploaded by admin, kept for audit/re-edit
  isPublished   Boolean  @default(false)
  createdById   String
  createdBy     User     @relation("TestAuthor", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  questions Question[]
  attempts  Attempt[]

  @@map("tests")
}

model Question {
  id           String  @id @default(cuid())
  testId       String
  test         Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  order        Int // position within the test, taken from the MD file
  section      String // domain/topic tag, e.g. "Networking" — free text from MD
  prompt       String  @db.Text
  options      Json // [{ key: "A", text: "..." }, ...]
  correctKeys  Json // ["A"] or ["A","C"] for multi-select

  answers AttemptAnswer[]

  @@index([testId])
  @@map("questions")
}

model Attempt {
  id           String    @id @default(cuid())
  testId       String
  test         Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId    String
  student      User      @relation(fields: [studentId], references: [id])
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  totalCount   Int? // total questions, set on finish
  correctCount Int? // correct answers, set on finish
  scorePercent Float? // correctCount / totalCount * 100
  passed       Boolean?
  sectionStats Json? // { "Networking": { correct: 5, total: 8 }, ... }

  answers AttemptAnswer[]

  @@index([studentId])
  @@index([testId])
  @@map("attempts")
}

model AttemptAnswer {
  id          String   @id @default(cuid())
  attemptId   String
  attempt     Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedKeys Json // keys the student picked, e.g. ["B"]
  isCorrect   Boolean

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}
